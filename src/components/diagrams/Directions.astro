---
// The eight guardians on their 3x3 grid, centre left empty. Names, directions
// and weapons are exactly the table in src/content/codex/dikpalas.md. Drawn
// north-up, and every cell states its own direction so the orientation cannot
// be misread.
type Cell = { dir: string; name: string; weapon: string; maha?: boolean };

const GRID: (Cell | null)[] = [
  { dir: "NW", name: "Vaayu", weapon: "Ankusha" },
  { dir: "N", name: "Kubera", weapon: "Gada", maha: true },
  { dir: "NE", name: "Ishana", weapon: "Trishula" },
  { dir: "W", name: "Varuna", weapon: "Paasha", maha: true },
  null,
  { dir: "E", name: "Indra", weapon: "Vajra", maha: true },
  { dir: "SW", name: "Nirrti", weapon: "Khadga" },
  { dir: "S", name: "Yama", weapon: "Danda", maha: true },
  { dir: "SE", name: "Agni", weapon: "Shakti" },
];

const W = 88, H = 72, GAP = 4, X0 = 14, Y0 = 44;
const VB_H = Y0 + 3 * H + 2 * GAP + 40;
const left = (c: number) => X0 + c * (W + GAP);
const top = (r: number) => Y0 + r * (H + GAP);
---

<figure class="diagram">
  <svg viewBox={`0 0 300 ${VB_H}`} role="img" aria-labelledby="dik-t dik-d">
    <title id="dik-t">The eight dikpalas on a three-by-three grid</title>
    <desc id="dik-d">
      A three-by-three grid drawn north-up. Each of the eight outer cells holds one
      guardian of a direction with the weapon they carry: Vaayu northwest, Kubera north,
      Ishana northeast, Varuna west, Indra east, Nirrti southwest, Yama south and Agni
      southeast. The centre square is left empty.
    </desc>

    <text class="d-foot" x="150" y="26" text-anchor="middle">↑ north</text>

    {GRID.map((cell, i) => {
      const r = Math.floor(i / 3), c = i % 3;
      const x = left(c), y = top(r);
      if (!cell) {
        return (
          <g>
            <rect class="cell empty" x={x} y={y} width={W} height={H} rx="4" />
            <text class="empty-label" x={x + W / 2} y={y + H / 2 + 4} text-anchor="middle">left empty</text>
          </g>
        );
      }
      return (
        <g class={cell.maha ? "maha" : ""}>
          <rect class="cell" x={x} y={y} width={W} height={H} rx="4" />
          <text class="dir" x={x + W / 2} y={y + 19} text-anchor="middle">{cell.dir}</text>
          <text class="name" x={x + W / 2} y={y + 39} text-anchor="middle">{cell.name}</text>
          <text class="weapon" x={x + W / 2} y={y + 55} text-anchor="middle">{cell.weapon}</text>
        </g>
      );
    })}

    <text class="d-foot" x="150" y={VB_H - 14} text-anchor="middle">bold = the four Mahadikpalas</text>
  </svg>
  <figcaption>
    The eight guardians, each on the direction they rule, with the weapon they carry.
    Kubera, Yama, Indra and Varuna are the four Mahadikpalas. Brahma (zenith) and
    Vishnu (nadir) have no square: they sit off the grid.
  </figcaption>
</figure>

<style>
  .cell { fill: var(--paper); stroke: var(--paper-3); stroke-width: 1.2; }
  .maha .cell { stroke: var(--sepia); stroke-width: 2; }
  .empty { fill: none; stroke-dasharray: 4 4; stroke: var(--ink-3); }
  .empty-label { font-family: var(--font-ui); font-size: 9.5px; font-style: italic; fill: var(--ink-3); }

  .dir { font-family: var(--font-ui); font-size: 9px; font-weight: 600; letter-spacing: 0.1em; fill: var(--ink-3); }
  .name { font-family: var(--font-text); font-size: 13px; fill: var(--ink); }
  .maha .name { font-weight: 700; fill: var(--sepia); }
  .weapon { font-family: var(--font-ui); font-size: 8.5px; font-style: italic; fill: var(--ink-3); }
</style>
