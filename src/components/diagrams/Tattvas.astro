---
// The tattvas as a descent from subtle to gross. The seven groups and their five
// members each are the book's own table in src/content/codex/tattvas.md, read
// bottom-up so the subtlest sit at the top. The table also gives each cell a
// Devanagari letter; those survive in the source only as legacy font bytes, so
// they are left out here rather than printed as nonsense.
const GROUPS = [
  { name: "Shuddha-tattvas", members: ["Kriya", "Gyana", "Ichhna", "Shakti", "Shiva"] },
  { name: "Kanchukas", members: ["Action", "Knowledge", "Desire", "Time", "Fate"] },
  { name: "Antahkarnas", members: ["Prakriti", "Ahamkara", "Buddhi", "Manas", "Purusha"] },
  { name: "Gyanendriyas", members: ["Smelling", "Tasting", "Seeing", "Feeling", "Hearing"] },
  { name: "Karmendriyas", members: ["Excreting", "Sexing", "Grasping", "Moving", "Speaking"] },
  { name: "Tanmatas", members: ["Scent", "Taste", "Sight", "Touch", "Sound"] },
  { name: "Mahabhutas", members: ["Earth", "Water", "Fire", "Air", "Ether"] },
];

const X0 = 30, ROW = 44, Y0 = 32, GAP = 3;
const VB_H = Y0 + GROUPS.length * ROW + 16;
const AXIS_BOTTOM = Y0 + GROUPS.length * ROW - GAP;
---

<figure class="diagram">
  <svg viewBox={`0 0 300 ${VB_H}`} role="img" aria-labelledby="tat-t tat-d">
    <title id="tat-t">The tattvas, from subtle to gross</title>
    <desc id="tat-d">
      Seven groups of five principles stacked as a descent. From the top: Shuddha-tattvas,
      Kanchukas, Antahkarnas, Gyanendriyas, Karmendriyas, Tanmatas and Mahabhutas, the
      five gross elements, at the bottom.
    </desc>

    <defs>
      <marker id="tat-tip" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 z" class="axis-tip" />
      </marker>
    </defs>
    <line class="axis" x1="15" y1={Y0} x2="15" y2={AXIS_BOTTOM} marker-end="url(#tat-tip)" />
    <text class="axis-label" transform={`translate(11 ${(Y0 + AXIS_BOTTOM) / 2}) rotate(-90)`} text-anchor="middle">
      subtle → gross
    </text>

    {GROUPS.map((g, i) => {
      const y = Y0 + i * ROW;
      return (
        <g>
          <rect class="band" x={X0} y={y} width={300 - X0 - 8} height={ROW - GAP} rx="3" />
          <rect class="tab" x={X0} y={y} width="4" height={ROW - GAP} style={`fill-opacity:${0.28 + i * 0.1}`} />
          <text class="g-name" x={X0 + 12} y={y + 17}>{g.name}</text>
          <text class="g-members" x={X0 + 12} y={y + 32}>{g.members.join(" · ")}</text>
        </g>
      );
    })}
  </svg>
  <figcaption>
    Samkhya's principles as a descent: the subtlest at the top, the five gross
    elements at the bottom. Each cell in the book's table also carries a
    Devanagari letter, which is why the professor calls it a periodic table.
  </figcaption>
</figure>

<style>
  .band { fill: var(--paper); stroke: var(--paper-3); stroke-width: 1; }
  .tab { fill: var(--sepia); }
  .g-name { font-family: var(--font-text); font-size: 11.5px; font-weight: 700; fill: var(--ink); }
  .g-members { font-family: var(--font-ui); font-size: 9px; fill: var(--ink-2); }
  .axis { stroke: var(--ink-3); stroke-width: 1.2; }
  .axis-tip { fill: var(--ink-3); }
  .axis-label { font-family: var(--font-ui); font-size: 9px; letter-spacing: 0.06em; fill: var(--ink-3); }
</style>
